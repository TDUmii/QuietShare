#include <windows.h>
#include "Version.h"

1 RT_MANIFEST "app.manifest"
101 ICON "quietshare.ico"
401 RCDATA "../assets/codicons/codicon.ttf"
// Payload resources 301-306 are added post-link with Windows UpdateResource.
// Keeping multi-megabyte payloads out of windres avoids its large-COFF heap crash.

1 VERSIONINFO
FILEVERSION QUIETSHARE_FILE_VERSION
PRODUCTVERSION QUIETSHARE_FILE_VERSION
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "QuietShare\0"
            VALUE "FileDescription", "QuietShare private teleprompter installer\0"
            VALUE "FileVersion", QUIETSHARE_VERSION_TEXT "\0"
            VALUE "InternalName", "QuietShare-Setup\0"
            VALUE "OriginalFilename", "QuietShare-Setup.exe\0"
            VALUE "ProductName", "QuietShare\0"
            VALUE "ProductVersion", QUIETSHARE_VERSION_TEXT "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
