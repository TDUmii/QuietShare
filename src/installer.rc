#include <windows.h>

1 RT_MANIFEST "app.manifest"
101 ICON "quietshare.ico"
301 RCDATA "../dist/QuietShare.exe"
302 RCDATA "../dist/Scintilla.dll"
303 RCDATA "../dist/Lexilla.dll"
304 RCDATA "../dist/pdfium.dll"
305 RCDATA "../dist/THIRD-PARTY.md"

1 VERSIONINFO
FILEVERSION 0,4,0,0
PRODUCTVERSION 0,4,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "QuietShare\0"
            VALUE "FileDescription", "QuietShare private teleprompter installer\0"
            VALUE "FileVersion", "0.4.0\0"
            VALUE "InternalName", "QuietShare-Setup\0"
            VALUE "OriginalFilename", "QuietShare-Setup.exe\0"
            VALUE "ProductName", "QuietShare\0"
            VALUE "ProductVersion", "0.4.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
